#!/usr/bin/env python3
#
#Classify a .nii by type
#  - volumetric
#  - cifti
#  - surface (confirmed via intent code 1007-1009)
#  - surface? (heuristic: 1D/2D vertex array without 3D spatial grid)
#  - unknown
  
import struct
import enum
import os
import sys
from pathlib import Path
import argparse

DEBUG = False

def debug_print(*args, **kwargs):
    """
    Works like print() but only when DEBUG is True
    """
    if DEBUG:
        print(*args, **kwargs)

class NIfTIHeaderParser:
    class ImageType(enum.Enum):
        VOLUMETRIC = 'volumetric'
        SURFACE = 'surface'
        SURFACE_HEURISTIC = 'surface?'
        CIFTI = 'cifti'
        UNKNOWN = 'unknown'

    @classmethod
    def parse_nifti_header(cls, filepath):
        try:
            with open(filepath, 'rb') as f:
                header_start = f.read(348)
                try:
                    sizeof_hdr_le = struct.unpack('<I', header_start[0:4])[0]
                    sizeof_hdr_be = struct.unpack('>I', header_start[0:4])[0]
                except struct.error:
                    debug_print("Could not read header length")
                    return cls.ImageType.UNKNOWN, None

                # Determine NIfTI version and endianness
                if sizeof_hdr_le == 348:
                    header_bytes = header_start
                    header_info = cls._parse_nifti1_header(header_bytes, filepath, big_endian=False)
                    image_type = cls._classify_image(header_info, filepath)
                elif sizeof_hdr_le == 540:
                    header_bytes = header_start + f.read(540 - 348)
                    header_info = cls._parse_nifti2_header(header_bytes, filepath, big_endian=False)
                    image_type = cls._classify_image(header_info, filepath)
                elif sizeof_hdr_be == 348:
                    header_bytes = header_start
                    header_info = cls._parse_nifti1_header(header_bytes, filepath, big_endian=True)
                    image_type = cls._classify_image(header_info, filepath)
                elif sizeof_hdr_be == 540:
                    header_bytes = header_start + f.read(540 - 348)
                    header_info = cls._parse_nifti2_header(header_bytes, filepath, big_endian=True)
                    image_type = cls._classify_image(header_info, filepath)
                else:
                    debug_print(f"Unknown header length: {sizeof_hdr_le}")
                    return cls.ImageType.UNKNOWN, None

                debug_print(f"Classified image type: {image_type}")
                return image_type, header_info

        except Exception as e:
            debug_print(f"Error parsing {filepath}: {e}")
            return cls.ImageType.UNKNOWN, None

    @classmethod
    def _parse_nifti1_header(cls, header_bytes, filepath, big_endian=False):
        try:
            unpack_fmt = '>8H' if big_endian else '<8H'
            dim = struct.unpack(unpack_fmt, header_bytes[40:56])
            intent_code_fmt = '>h' if big_endian else '<h'
            intent_code = struct.unpack(intent_code_fmt, header_bytes[68:70])[0]
            datatype_fmt = '>h' if big_endian else '<h'
            datatype = struct.unpack(datatype_fmt, header_bytes[70:72])[0]
            magic = header_bytes[344:348].decode('ascii', errors='ignore').strip()

            return {
                'version': 1,
                'dimensions': dim[1:dim[0]+1],
                'ndim': dim[0],
                'magic': magic,
                'datatype': datatype,
                'intent_code': intent_code,
                'endian': 'big' if big_endian else 'little'
            }
        except struct.error as e:
            debug_print(f"NIfTI-1 parsing error: {e}")
            return None

    @classmethod
    def _parse_nifti2_header(cls, header_bytes, filepath, big_endian=False):
        try:
            unpack_fmt = '>8q' if big_endian else '<8q'
            dim = struct.unpack(unpack_fmt, header_bytes[16:80])
            intent_code_fmt = '>i' if big_endian else '<i'
            intent_code = struct.unpack(intent_code_fmt, header_bytes[504:508])[0]
            datatype_fmt = '>h' if big_endian else '<h'
            datatype = struct.unpack(datatype_fmt, header_bytes[12:14])[0]
            magic = header_bytes[4:12].decode('ascii', errors='ignore').strip()

            return {
                'version': 2,
                'dimensions': dim[1:dim[0]+1],
                'ndim': dim[0],
                'magic': magic,
                'datatype': datatype,
                'intent_code': intent_code,
                'endian': 'big' if big_endian else 'little'
            }
        except struct.error as e:
            debug_print(f"NIfTI-2 parsing error: {e}")
            return None

    @classmethod
    def _classify_image(cls, header_info, filepath):
        if not header_info:
            return cls.ImageType.UNKNOWN

        filename = Path(filepath).name.lower()

        # CIFTI identification by file naming or intent codes
        cifti_extensions = ('.dtseries.nii', '.dscalar.nii', '.dlabel.nii', '.dconn.nii', '.pconn.nii')
        if any(filename.endswith(ext) for ext in cifti_extensions):
            return cls.ImageType.CIFTI

        intent = header_info.get('intent_code', 0)
        if 3000 <= intent <= 3099:
            return cls.ImageType.CIFTI

        # Surface identification by explicit standard intent codes
        # 1007: NODE_INDEX, 1008: POINTSET, 1009: TRIANGLE
        SURFACE_INTENT_CODES = [1006, 1007, 1008, 1009]
        if intent in SURFACE_INTENT_CODES:
            return cls.ImageType.SURFACE

        dims = header_info.get('dimensions', ())
        ndim = header_info.get('ndim', 0)

        # Volumetric check:
        # A 3D or 4D volume must have 3 spatial dimensions where X > 1, Y > 1, Z > 1.
        if ndim >= 3 and len(dims) >= 3:
            if dims[0] > 1 and dims[1] > 1 and dims[2] > 1:
                return cls.ImageType.VOLUMETRIC

        # Heuristic Surface check:
        # 1D or 2D vector arrays (e.g. 32,492 vertices, with Y=1, Z=1)
        if ndim in (1, 2) or (ndim >= 3 and (dims[1] == 1 or dims[2] == 1)):
            return cls.ImageType.SURFACE_HEURISTIC

        return cls.ImageType.UNKNOWN

def main():
    parser = argparse.ArgumentParser(
        description="Classify NIfTI (.nii) file type (volumetric, cifti, surface, surface?, unknown)."
    )
    parser.add_argument(
        'filepath',
        help="Path to the NIfTI file to inspect"
    )
    parser.add_argument(
        '-d', '--detail',
        action='store_true',
        help="Print detailed header metadata"
    )

    args = parser.parse_args()

    global DEBUG
    DEBUG = args.detail

    target_path = Path(args.filepath)

    # Validate that the file exists and is a regular file
    if not target_path.exists():
        sys.stderr.write(f"Error: File not found: '{args.filepath}'\n")
        sys.exit(1)

    if not target_path.is_file():
        sys.stderr.write(f"Error: '{args.filepath}' is not a regular file.\n")
        sys.exit(1)

    image_type, header_info = NIfTIHeaderParser.parse_nifti_header(target_path.resolve())

    # Classification output to stdout
    print(image_type.value)

    if args.detail:
        if header_info:
            print("\nHeader Details:")
            for key, value in header_info.items():
                print(f"  {key}: {value}")
        else:
            print("\nCould not retrieve header details.")


if __name__ == '__main__':
    main()
